generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model usuario {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  password           String
  admin              Boolean             @default(false)
  incricao           incricao[]
  passwordresettoken passwordresettoken?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model passwordresettoken {
  id        Int      @id(map: "token_pkey") @default(autoincrement())
  token     String   @unique(map: "token_token_key")
  createdby Int      @unique
  createdat DateTime @default(now()) @db.Timestamptz(6)
  expiresat DateTime @db.Timestamptz(6)
  usuario   usuario  @relation(fields: [createdby], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "token_createdby_fkey")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categoria {
  id_torneio    BigInt
  name          String     @db.VarChar
  value         Float      @default(0)
  fide          Boolean    @default(false)
  cbx           Boolean    @default(false)
  just_superior Boolean    @default(false)
  min_y         Int
  max_y         Int
  uuid          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  torneio       torneio    @relation(fields: [id_torneio], references: [id], onDelete: Cascade, onUpdate: NoAction)
  incricao      incricao[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model incricao {
  city       String              @db.VarChar
  club       String?             @db.VarChar
  genre      Boolean             @default(true)
  data_nasc  DateTime            @db.Date
  id_fide    BigInt?
  id_cbx     BigInt?
  division   division            @default(sem)
  uuid_cat   String              @db.Uuid
  status     status_inscripition @default(pending)
  id_usuario Int
  uuid       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  n_group    Int?                @db.SmallInt
  name       String
  id_torneio BigInt              @default(0)
  ids_mp     ids_mp[]
  torneio    torneio             @relation(fields: [id_torneio], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario    usuario             @relation(fields: [id_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoria  categoria           @relation(fields: [uuid_cat], references: [uuid], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model torneio {
  id                                BigInt      @id @default(autoincrement())
  title                             String      @unique(map: "torneio_name_key")
  time_analog                       BigInt?
  time_digital                      BigInt?     @map("time-digital")
  local                             String
  local_link                        String?
  date_event                        DateTime    @db.Timestamptz(6)
  date_inscri                       DateTime    @db.Timestamptz(6)
  has_division                      Boolean     @default(false)
  folder_path                       String?
  reg_path                          String?
  qr_path                           String?
  chave_pix                         String?
  link_chessresults                 String?
  categoria                         categoria[]
  emails                            emails[]
  incricao                          incricao[]
  tempo_torneio_time_digitalTotempo tempo?      @relation("torneio_time_digitalTotempo", fields: [time_digital], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tempo_torneio_time_analogTotempo  tempo?      @relation("torneio_time_analogTotempo", fields: [time_analog], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ids_mp {
  id            BigInt    @id @default(autoincrement())
  id_individual String?   @db.Uuid
  id_group      Int?      @db.SmallInt
  id_mp         String
  incricao      incricao? @relation(fields: [id_individual], references: [uuid], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tempo {
  id                                  BigInt    @id @default(autoincrement())
  time                                Int
  plus                                Int       @default(0) @db.SmallInt
  torneio_torneio_time_digitalTotempo torneio[] @relation("torneio_time_digitalTotempo")
  torneio_torneio_time_analogTotempo  torneio[] @relation("torneio_time_analogTotempo")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model emails {
  id         BigInt  @id @default(autoincrement())
  id_torneio BigInt
  email      String
  torneio    torneio @relation(fields: [id_torneio], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum division {
  escolar
  superior
  sem
}

enum status_inscripition {
  pending
  confirmed
}
